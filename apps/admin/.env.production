# Admin Console — Production env (Vercel)
# Mirror these in the Vercel dashboard for the production deployment.

# Backend API base URL.
VITE_API_BASE_URL=https://paychainke-backend.onrender.com

# Stellar network the UI should reference in chain-aware copy.
# Allowed: testnet | mainnet
VITE_STELLAR_NETWORK=mainnet

# Environment label (rendered in System Status / build pills).
VITE_ENVIRONMENT=production
