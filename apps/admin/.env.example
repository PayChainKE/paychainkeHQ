# PayChain Admin Console — Environment Variables
#
# Copy this file to `.env` for local development. Vercel preview/production
# environments inject these via the dashboard, not via committed files.

# Base URL of the PayChain backend (Render).
# Local dev: leave empty to use the Vite proxy (vite.config.js → /api → :5000).
# Staging:   https://paychainke-backend.onrender.com
# Prod:      https://paychainke-backend.onrender.com
VITE_API_BASE_URL=http://localhost:5000

# Legacy alias for the same value — kept for backwards-compat with older code.
# VITE_API_URL=http://localhost:5000

# Which Stellar network the wallet audit + ledger headers reference.
# Allowed: testnet | mainnet
VITE_STELLAR_NETWORK=testnet

# Optional label shown in some surfaces (system info card, log lines).
# Allowed: development | staging | production
VITE_ENVIRONMENT=development

# Error monitoring (Sentry). Leave unset to disable entirely.
VITE_SENTRY_DSN=
