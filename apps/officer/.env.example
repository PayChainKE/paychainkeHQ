# PayChain Officer Console — Environment Variables
#
# Copy this file to `.env` for local development. Vercel preview/production
# environments inject these via the dashboard, not via committed files.

# Base URL of the PayChain backend (Render).
# Local dev: leave empty to use the Vite proxy (vite.config.js → /api → :5000).
VITE_API_BASE_URL=http://localhost:5000

# Optional label shown in some surfaces.
# Allowed: development | staging | production
VITE_ENVIRONMENT=development

# Error monitoring (Sentry). Leave unset to disable entirely.
VITE_SENTRY_DSN=
