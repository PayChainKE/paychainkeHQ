# PayChain Merchant Dashboard - Environment Variables Example

# The base URL for the backend API
# If not provided, it defaults to https://www.paychain.co.ke
VITE_API_URL=http://localhost:5000
# Alternatively (legacy support):
# VITE_API_BASE_URL=http://localhost:5000

# Error monitoring (Sentry). Leave unset to disable entirely.
VITE_SENTRY_DSN=

# Canonical origin embedded in payment links and QR codes shown to
# customers. Deliberately NOT derived from window.location.origin — this
# app is reachable from more than one real hostname (the custom domain AND
# the raw Vercel deployment URL), so links must always point at the official
# domain regardless of which one a merchant happens to be browsing from.
# If not provided, defaults to https://app.paychain.co.ke (matches the
# backend's MERCHANT_DASHBOARD_URL).
# VITE_APP_URL=https://app.paychain.co.ke
