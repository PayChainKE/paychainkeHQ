{
  "name": "paychain-monorepo",
  "private": true,
  "version": "1.0.0",
  "packageManager": "npm@10.0.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "backend"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "dev:web": "turbo run dev --filter=@paychain/web",
    "dev:backend": "turbo run dev --filter=@paychain/backend",
    "build:web": "turbo run build --filter=@paychain/web",
    "build:backend": "turbo run build --filter=@paychain/backend"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "expo-local-authentication": "^56.0.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "overrides": {
    "@paychain/web": {
      "react": "18.3.1",
      "react-dom": "18.3.1"
    },
    "paychain-merchant": {
      "react": "18.3.1",
      "react-dom": "18.3.1"
    },
    "@paychain/admin": {
      "react": "18.3.1",
      "react-dom": "18.3.1"
    },
    "demo": {
      "react": "18.3.1",
      "react-dom": "18.3.1"
    }
  }
}
