# ---- Shopify -------------------------------------------------------------
# Your store's address.
SHOPIFY_SHOP=my-store.myshopify.com
# Use ONE of these two ways of giving the service access:
#  (a) an Admin API access token (shpat_...) from a custom app in your store
SHOPIFY_ADMIN_TOKEN=
#  (b) an app made in the Shopify Dev Dashboard: its client id and secret
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Checks that a new-order notice really came from Shopify. With (b) this is the
# client secret and can be left empty. With (a) it is the app's "API secret key".
SHOPIFY_WEBHOOK_SECRET=
# SHOPIFY_API_VERSION=2026-07

# ---- PayChain ------------------------------------------------------------
# pc_test_... to try it out (no real money); pc_live_... to take real payments.
PAYCHAIN_API_KEY=
# The secret of the webhook you register in the developer portal, pointing to
#   https://<this service>/webhooks/paychain
PAYCHAIN_WEBHOOK_SECRET=
# PAYCHAIN_API_BASE=https://api.paychain.co.ke

# ---- This service --------------------------------------------------------
# Public https address of this service (used to register the Shopify webhook).
PUBLIC_URL=https://pay.example.com
PORT=8788
# An order is treated as an M-PESA order when its payment method name contains this.
PAYMENT_METHOD_MATCH=m-pesa
# Minutes a payment link stays valid (5 to 10080).
SESSION_TTL_MINUTES=60
# 1 = a payment made with a pc_test_ key marks the order paid (for a dev store only).
TEST_PAYMENTS_MARK_PAID=0
# 1 only when running behind a proxy you control (Render, Railway, nginx).
TRUST_PROXY=0
