# PayChainKE Backend Environment Variables

# Tailscale Secure VPN Configuration
TS_AUTHKEY=tskey-auth-xxxx-xxxx # Your Tailscale Auth Key
TS_EXTRA_ARGS=--tun=userspace-networking # Required for Render's rootless environment

# ── Core ───────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://...
JWT_SECRET=your_jwt_secret
PORT=5000
NODE_ENV=production

# ── Frontend URLs (used in outgoing emails for setup / reset links) ────
# Domains served by Vercel (matched against the CORS allow-list in server.js):
#   Marketing site → https://www.paychain.co.ke
#   Admin console  → https://www.admin.paychain.co.ke
#   Merchant app   → https://www.app.paychain.co.ke
#   Demo dashboard → https://www.demo.paychain.co.ke
ADMIN_DASHBOARD_URL=https://admin.paychain.co.ke
MERCHANT_DASHBOARD_URL=https://app.paychain.co.ke

# ── Email Service ──────────────────────────────────────────────────────
RESEND_API_KEY=re_...

# ── Stellar / Wallet ───────────────────────────────────────────────────
# 32-byte hex key used to AES-encrypt merchant Stellar secret keys at rest.
ENCRYPTION_MASTER_KEY=
# USDC issuer account on the active network (testnet vs mainnet).
USDC_ISSUER_ADDRESS=
STELLAR_NETWORK=testnet

# ── M-Pesa (Safaricom Daraja) ──────────────────────────────────────────
# Defaults to sandbox — must be explicitly set to 'live' to reach
# production (see mpesaController.js's top-of-file comment for why this is
# never derived from NODE_ENV).
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
# Second, deliberate safety gate — MPESA_ENVIRONMENT=live alone isn't
# enough to send real money; this must also be 'true'.
MPESA_LIVE_ENABLED=false
# B2C (merchant withdrawals — initiateB2C, bulk pay payouts). Requires
# separate whitelisting from Safaricom beyond basic STK/C2B Go-Live.
# InitiatorName is the operator username you create in the Safaricom
# Business Portal (User Management → Create Operator, role: Business
# Manager); MPESA_B2C_PASSWORD is that operator's password.
MPESA_B2C_INITIATOR=
MPESA_B2C_PASSWORD=
# The Daraja portal's "Test Credentials" tool encrypts your Initiator
# Password server-side and hands back the finished SecurityCredential
# directly (no downloadable cert file) — generate once per environment
# there and paste the result here. It's static: re-encrypting the same
# password produces a different-looking string each time (RSA/PKCS1
# padding is randomized) but all of them decrypt the same on Safaricom's
# end, so this only needs regenerating if the Initiator password changes.
MPESA_B2C_SECURITY_CREDENTIAL_SANDBOX=
MPESA_B2C_SECURITY_CREDENTIAL_PRODUCTION=
# Fallback only: if a real RSA public certificate ever becomes available
# instead (e.g. via a Safaricom account rep), utils/safaricomCrypto.js can
# encrypt MPESA_B2C_PASSWORD at request time using these. Paste each cert
# exactly as downloaded, with real newlines replaced by literal \n
# (safaricomCrypto.js reverses this). Never commit real certificate
# content to source control. Ignored if the static vars above are set.
MPESA_B2C_SANDBOX_CERT=
MPESA_B2C_PRODUCTION_CERT=

# ── NCBA Bank ───────────────────────────────────────────────────────────
# 4-digit institution prefix NCBA assigns PayChain; concatenated with a
# merchant's 8-digit code to form the full 12-digit Virtual Account number.
NCBA_INSTITUTION_PREFIX=
# HTTP Basic Auth credentials NCBA uses to call the Virtual Account
# reconciliation webhook (routes/ncbaRoutes.js: /webhooks/ncba-reconciliation).
NCBA_API_USERNAME=
NCBA_API_PASSWORD=
# Credentials for the Account-Level Notification Push (SOAP). Per NCBA's
# guide these are embedded in the XML body's <User>/<Password> tags on
# every notification (not an HTTP header) — PayChain supplies these values
# to NCBA during onboarding and verifies them here on receipt.
NCBA_ACCOUNT_NOTIFICATION_USERNAME=
NCBA_ACCOUNT_NOTIFICATION_PASSWORD=
# Shared secret used to compute/verify the notification's <HashVal>
# (SHA-256 over the transaction fields + this key — see utils/ncbaHashVal.js).
NCBA_ACCOUNT_NOTIFICATION_SECRET_KEY=

# NCBA Bulk Payments (Host-to-Host) — services/ncbaBulkPaymentService.js.
# A separate NCBA product from Open Banking below: a file-based bulk
# disbursement rail with its own auth (static API key, not OAuth).
NCBA_ENVIRONMENT=sandbox
NCBA_BASE_URL=
NCBA_SANDBOX_BASE_URL=
NCBA_API_KEY=
NCBA_SETTLEMENT_ACCOUNT=
NCBA_LIVE_ENABLED=false
NCBA_BILLER_CODE_KPLC=
NCBA_BILLER_CODE_WATER=

# NCBA Open Banking — services/ncbaOpenBankingService.js. Powers merchant
# bank payouts (PesaLink/EFT) via NCBA's REST API. UAT credentials are
# issued per NCBA's onboarding email; NCBA_OPENBANKING_LIVE_ENABLED gates
# whether real calls are made at all (sandbox or live) vs. simulated
# locally — see the service file for why.
NCBA_OPENBANKING_ENVIRONMENT=sandbox
NCBA_OPENBANKING_BASE_URL=
NCBA_OPENBANKING_SANDBOX_BASE_URL=https://openbankingtest.api.ncbagroup.com/test/apigateway
NCBA_OPENBANKING_USER_ID=
NCBA_OPENBANKING_PASSWORD=
NCBA_OPENBANKING_SUBSCRIPTION_KEY=
NCBA_OPENBANKING_ACCOUNT_NUMBER=
# "Customer number – first 6 digits of the sender account number or any
# other assigned customer number as guided by NCBA" (UAT Guide). Required
# on every PesaLink/EFT payload.
NCBA_OPENBANKING_SENDER_CIF=
NCBA_OPENBANKING_LIVE_ENABLED=false

# ── Africa's Talking (SMS: merchant OTP + NCBA transaction alerts) ─────
# https://account.africastalking.com → Settings → API Key. Use username
# 'sandbox' for testing (sandbox.africastalking.com) — AT_SENDER_ID is
# ignored for sandbox accounts (see utils/notificationService.js).
AT_API_KEY=
AT_USERNAME=sandbox
# Optional: alphanumeric sender ID / short code. Only used for real
# (non-sandbox) accounts.
AT_SENDER_ID=
