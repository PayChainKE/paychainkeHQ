# PayChainKE Backend Environment Variables

# Tailscale Secure VPN Configuration
TS_AUTHKEY=tskey-auth-xxxx-xxxx # Your Tailscale Auth Key
TS_EXTRA_ARGS=--tun=userspace-networking # Required for Render's rootless environment

# ── Core ───────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://...
JWT_SECRET=your_jwt_secret
PORT=5000
NODE_ENV=production

# Only used by seed-admin.js (a one-off script, not the running server) —
# required, no hardcoded fallback, so a real admin credential never sits in
# source control. Set these as ad-hoc shell env vars when you actually need
# to run the script, not as permanent Render env vars.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# ── Frontend URLs (used in outgoing emails for setup / reset links) ────
# Domains served by Vercel (matched against the CORS allow-list in server.js):
#   Marketing site → https://www.paychain.co.ke
#   Admin console  → https://www.admin.paychain.co.ke
#   Merchant app   → https://www.app.paychain.co.ke
#   Demo dashboard → https://www.demo.paychain.co.ke
ADMIN_DASHBOARD_URL=https://admin.paychain.co.ke
MERCHANT_DASHBOARD_URL=https://app.paychain.co.ke

# ── Email Service ──────────────────────────────────────────────────────
RESEND_API_KEY=re_...

# ── Stellar / Wallet ───────────────────────────────────────────────────
# 32-byte hex key used to AES-encrypt merchant Stellar secret keys at rest.
ENCRYPTION_MASTER_KEY=
# USDC issuer account on the active network (testnet vs mainnet).
USDC_ISSUER_ADDRESS=
STELLAR_NETWORK=testnet

# ── M-Pesa (Safaricom Daraja) ──────────────────────────────────────────
# STK Push, B2C and B2B all route through NCBA now (see the NCBA sections
# below) — Daraja is only still used for C2B webhook registration
# (registerURLs), which exists solely to drive the Stellar demo-merchant
# pipeline (see adminController.js's createMerchant/simulateMpesaConfirmation
# doc comments). Defaults to sandbox — must be explicitly set to 'live' to
# reach production (see mpesaController.js's top-of-file comment for why
# this is never derived from NODE_ENV).
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_CALLBACK_URL=
# Daraja has no native webhook signature — this is embedded as ?key= in
# every ConfirmationURL/ValidationURL handed to Safaricom
# (routes/mpesaRoutes.js verifies it on every public webhook route).
# Generate a long random value, e.g. `openssl rand -hex 32`. After setting
# this, the Confirmation/Validation URLs must be re-registered with
# Safaricom via POST /register-urls (owner-admin only) so they carry the
# new secret.
MPESA_WEBHOOK_SECRET=

# Same shared-secret-in-URL pattern as MPESA_WEBHOOK_SECRET above, for
# Africa's Talking's SMS delivery-report webhook (routes/smsRoutes.js).
# Generate with `openssl rand -hex 32`. After setting this, update the
# delivery report callback URL in the Africa's Talking dashboard to
# `.../api/sms/delivery-report?key=<secret>` — until both are done, delivery
# reports will fail closed (403/500), same as an unconfigured MPESA_WEBHOOK_SECRET.
AT_DELIVERY_REPORT_SECRET=

# ── NCBA Bank ───────────────────────────────────────────────────────────
# 4-digit institution prefix NCBA assigns PayChain; concatenated with a
# merchant's 8-digit code to form the full 12-digit Virtual Account number.
NCBA_INSTITUTION_PREFIX=
# HTTP Basic Auth credentials NCBA uses to call the Virtual Account
# reconciliation webhook (routes/ncbaRoutes.js: /webhooks/ncba-reconciliation).
NCBA_API_USERNAME=
NCBA_API_PASSWORD=
# Credentials for the Account-Level Notification Push (SOAP). Per NCBA's
# guide these are embedded in the XML body's <User>/<Password> tags on
# every notification (not an HTTP header) — PayChain supplies these values
# to NCBA during onboarding and verifies them here on receipt.
NCBA_ACCOUNT_NOTIFICATION_USERNAME=
NCBA_ACCOUNT_NOTIFICATION_PASSWORD=
# Shared secret used to compute/verify the notification's <HashVal>
# (SHA-256 over the transaction fields + this key — see utils/ncbaHashVal.js).
NCBA_ACCOUNT_NOTIFICATION_SECRET_KEY=

# NCBA Bulk Payments (Host-to-Host) — services/ncbaBulkPaymentService.js.
# A separate NCBA product from Open Banking below: a file-based bulk
# disbursement rail with its own auth (static API key, not OAuth).
NCBA_ENVIRONMENT=sandbox
NCBA_BASE_URL=
NCBA_SANDBOX_BASE_URL=
NCBA_API_KEY=
NCBA_SETTLEMENT_ACCOUNT=
NCBA_LIVE_ENABLED=false
NCBA_BILLER_CODE_KPLC=
NCBA_BILLER_CODE_WATER=

# NCBA Open Banking — services/ncbaOpenBankingService.js. Powers merchant
# bank payouts (PesaLink/EFT) via NCBA's REST API. UAT credentials are
# issued per NCBA's onboarding email; NCBA_OPENBANKING_LIVE_ENABLED gates
# whether real calls are made at all (sandbox or live) vs. simulated
# locally — see the service file for why.
NCBA_OPENBANKING_ENVIRONMENT=sandbox
NCBA_OPENBANKING_BASE_URL=
NCBA_OPENBANKING_SANDBOX_BASE_URL=https://openbankingtest.api.ncbagroup.com/test/apigateway
NCBA_OPENBANKING_USER_ID=
NCBA_OPENBANKING_PASSWORD=
NCBA_OPENBANKING_SUBSCRIPTION_KEY=
NCBA_OPENBANKING_ACCOUNT_NUMBER=
# "Customer number – first 6 digits of the sender account number or any
# other assigned customer number as guided by NCBA" (UAT Guide). Required
# on every PesaLink/EFT payload.
NCBA_OPENBANKING_SENDER_CIF=
NCBA_OPENBANKING_LIVE_ENABLED=false

# NCBA STK Push (collections) — replaces Safaricom Daraja STK Push. Separate
# host/credentials from Open Banking above (services/ncbaStkPushService.js)
# — NCBA_STK_USERNAME/_PASSWORD fall back to NCBA_OPENBANKING_USER_ID/
# _PASSWORD if left blank, per NCBA's own confirmation that the Open Banking
# UAT creds work against this host too. NCBA_STK_LIVE_ENABLED gates whether
# real network calls are made at all vs. simulated locally, same pattern as
# NCBA_OPENBANKING_LIVE_ENABLED.
NCBA_STK_BASE_URL=https://c2bapis.ncbagroup.com
NCBA_STK_USERNAME=
NCBA_STK_PASSWORD=
# PayChain's dedicated NCBA Till short code for STK Push, issued directly by
# NCBA (per Rose Soy, 2026-08-11) — distinct from the 880100 Paybill shown
# elsewhere in the app for manual wallet top-ups; see the PayBillNo field
# name in the STK Push spec (NCBA's own API still calls a Till a "PayBillNo").
NCBA_STK_PAYBILL=889066
NCBA_STK_LIVE_ENABLED=false
# Endpoint path for the Hakikisha/Airtel Money mobile-number validation call
# that must precede a Mobile B2W payout. Confirmed from NCBA's "Open Banking
# V2 - Callback Enabled" Postman collection (/api/v1/MobileB2WValidation/
# validate-account) — services/ncbaOpenBankingService.js already defaults to
# this value, so this only needs setting if NCBA changes the path.
NCBA_MOBILE_WALLET_VALIDATION_PATH=

# ── Revenue reporting (controllers/revenueController.js) ───────────────
# Corporate account accumulated PayChain fees sweep to, shown on the admin
# Revenue page's settlement-batch log. Unset shows an honest "Not
# configured" state rather than a placeholder bank name.
PAYCHAIN_CORPORATE_SWEEP_ACCOUNT=

# ── Revenue sweep (services/revenueSweepService.js) ─────────────────────
# Real weekly PesaLink transfer of PayChain's accrued fee revenue OUT of
# the pooled NCBA paybill (where merchant funds also sit) into PayChain's
# own bank account — reuses the NCBA Open Banking config above, so it also
# obeys NCBA_OPENBANKING_ENVIRONMENT / NCBA_OPENBANKING_LIVE_ENABLED (stays
# simulated until those are set to live). Leave the two lines below unset
# until the destination account actually exists — the sweep safely no-ops
# (records a 'skipped' row) rather than failing loudly until they're set.
PAYCHAIN_REVENUE_BANK_CODE=
PAYCHAIN_REVENUE_ACCOUNT_NUMBER=
PAYCHAIN_REVENUE_ACCOUNT_NAME=PayChain Revenue Account
# Day of week the sweep runs, 0=Sunday..6=Saturday. Default: 1 (Monday).
PAYCHAIN_REVENUE_SWEEP_DAY=1

# ── Africa's Talking (SMS: merchant OTP + NCBA transaction alerts) ─────
# https://account.africastalking.com → Settings → API Key. Use username
# 'sandbox' for testing (sandbox.africastalking.com) — AT_SENDER_ID is
# ignored for sandbox accounts (see utils/notificationService.js).
AT_API_KEY=
AT_USERNAME=sandbox
# Optional: alphanumeric sender ID / short code. Only used for real
# (non-sandbox) accounts.
AT_SENDER_ID=

# ── WebAuthn / Passkeys (controllers/webauthnController.js) ────────────
# All three are optional — sensible defaults are built in (see that
# file's top-of-file comment) that auto-switch between production domains
# and http://localhost:5173 based on NODE_ENV, so local dev needs nothing
# set here at all. Only set these if the merchant-dashboard domain ever
# changes from app.paychain.co.ke.
# WEBAUTHN_RP_NAME=PayChain
# WEBAUTHN_RP_ID=app.paychain.co.ke
# WEBAUTHN_RP_ORIGIN=https://app.paychain.co.ke,https://www.app.paychain.co.ke
