# PayChainKE Backend Environment Variables

# Tailscale Secure VPN Configuration
TS_AUTHKEY=tskey-auth-xxxx-xxxx # Your Tailscale Auth Key
TS_EXTRA_ARGS=--tun=userspace-networking # Required for Render's rootless environment

# Core Configuration
MONGO_URI=mongodb+srv://...
JWT_SECRET=your_jwt_secret
PORT=5000
NODE_ENV=production

# Email Service
RESEND_API_KEY=re_...
