# PayChainKE Backend Environment Variables

# Tailscale Secure VPN Configuration
TS_AUTHKEY=tskey-auth-xxxx-xxxx # Your Tailscale Auth Key
TS_EXTRA_ARGS=--tun=userspace-networking # Required for Render's rootless environment

# ── Core ───────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://...
JWT_SECRET=your_jwt_secret
PORT=5000
NODE_ENV=production

# ── Frontend URLs (used in outgoing emails for setup / reset links) ────
# Defaults if unset:
#   ADMIN_DASHBOARD_URL    → https://admin.paychain.co.ke
#   MERCHANT_DASHBOARD_URL → https://merchant.paychain.co.ke
ADMIN_DASHBOARD_URL=https://admin.paychain.co.ke
MERCHANT_DASHBOARD_URL=https://merchant.paychain.co.ke

# ── Email Service ──────────────────────────────────────────────────────
RESEND_API_KEY=re_...

# ── Stellar / Wallet ───────────────────────────────────────────────────
# 32-byte hex key used to AES-encrypt merchant Stellar secret keys at rest.
ENCRYPTION_MASTER_KEY=
# USDC issuer account on the active network (testnet vs mainnet).
USDC_ISSUER_ADDRESS=
STELLAR_NETWORK=testnet

# ── M-Pesa (Safaricom Daraja) ──────────────────────────────────────────
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
